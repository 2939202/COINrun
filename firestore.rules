rules_version = '2';

// ============================================================
// Firestore 보안 규칙
//
// [이 파일은 아직 적용되어 있지 않습니다]
//   Firebase 콘솔 > Firestore Database > 규칙 에 아래 내용을 붙여넣고 "게시"를 눌러야
//   실제로 적용됩니다. (또는 firebase deploy --only firestore:rules)
//
// [왜 필요한가]
//   로그인이 붙으면서 계정마다 골드와 레벨이 생겼습니다. 규칙이 없으면
//   누구나 남의 골드를 읽고 고칠 수 있습니다. 아래 규칙은 "로그인한 사람은
//   자기 문서만 읽고 쓸 수 있다"로 잠급니다.
//
// [랭킹]
//   랭킹은 남의 기록도 읽어야 합니다. 그래서 users를 푸는 대신, 남에게 보여도 되는
//   값(닉네임/레벨/누적거리/누적경험치)만 leaderboard 컬렉션에 따로 복사해 둡니다.
//   골드나 이메일은 그쪽에 들어가지 않습니다.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 러닝 기록
      match /runs/{runId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 랭킹 목록
    //   읽기: 로그인한 사람은 누구나 (남의 순위를 봐야 하므로)
    //   쓰기: 자기 줄만. 남의 순위를 조작할 수 없습니다.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 위에서 허용하지 않은 모든 접근은 막습니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
