rules_version = '2';

// ============================================================
// Firestore 보안 규칙
//
// [적용]
//   이 파일을 고친 뒤에는 게시해야 실제로 적용됩니다.
//     firebase deploy --only firestore:rules --project spot7123-3ad2d
//   (firebase.json이 이 파일을 가리킵니다. 콘솔 > Firestore > 규칙에서 이전 판으로 되돌릴 수 있습니다)
//
// [왜 필요한가]
//   로그인이 붙으면서 계정마다 골드와 레벨이 생겼습니다. 규칙이 없으면
//   누구나 남의 골드를 읽고 고칠 수 있습니다. 아래 규칙은 "로그인한 사람은
//   자기 문서만 읽고 쓸 수 있다"로 잠급니다.
//
// [랭킹]
//   랭킹은 남의 기록도 읽어야 합니다. 그래서 users를 푸는 대신, 남에게 보여도 되는
//   값(닉네임/레벨/누적거리/누적경험치)만 leaderboard 컬렉션에 따로 복사해 둡니다.
//   골드나 이메일은 그쪽에 들어가지 않습니다.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 유저 문서와 그 아래 모든 것 (러닝 기록 runs, 경로 routes 등)
    //
    // {document=**}는 하위 컬렉션 전부를 뜻합니다. Firestore 규칙은 하위 컬렉션에
    // 자동으로 이어지지 않아서, 예전처럼 컬렉션마다 적어두면 새 컬렉션을 만들 때마다
    // 규칙 고치는 걸 잊고 "권한 없음"으로 저장이 막히게 됩니다.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 랭킹 목록
    //   읽기: 로그인한 사람은 누구나 (남의 순위를 봐야 하므로)
    //   쓰기: 자기 줄만. 남의 순위를 조작할 수 없습니다.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 사설 코스
    //   읽기: 로그인한 사람은 누구나 (남이 만든 코스를 달려야 하므로)
    //   만들기: 자기 이름(authorId)으로만
    //   고치기/지우기: 만든 사람만
    //   하트: 남의 코스에 한해, 하트 수(hearts)만 1씩 올리거나 내릴 수 있습니다.
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.hearts == 0;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.authorId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
        && (request.resource.data.hearts == resource.data.hearts + 1
            || request.resource.data.hearts == resource.data.hearts - 1);

      // 누가 하트를 눌렀는지. 자기 줄만 만들고 지울 수 있습니다.
      // 코스를 만든 사람은 탈퇴할 때 코스와 함께 하트 기록도 지울 수 있습니다.
      match /hearts/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId;
        allow delete: if request.auth != null
          && (request.auth.uid == userId
              || get(/databases/$(database)/documents/courses/$(courseId)).data.authorId
                 == request.auth.uid);
      }
    }

    // 위에서 허용하지 않은 모든 접근은 막습니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
